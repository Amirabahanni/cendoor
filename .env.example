# Copy to .env (never commit it) or set these in your host's dashboard.
PORT=3000
PUBLIC_URL=http://localhost:3000        # your public https address once deployed
CENDOOR_DEMO=1                          # shows "Reset demo data" in Settings (demo shop only)
CENDOOR_SEED=1                          # 0 = start with an empty database
CENDOOR_NETWORK_SECRET=change-me        # keys the phone-number hashes used by Cendoor Shield; keep it secret and stable
# CENDOOR_DATA_DIR=/data                # where the SQLite file and uploads live (mount a persistent disk here)
# ANTHROPIC_API_KEY=                    # optional: chat and Studio use Claude instead of the built-in rules
# CENDOOR_MODEL=claude-sonnet-5-5
# WHATSAPP_TOKEN=  WHATSAPP_PHONE_ID=  WHATSAPP_VERIFY_TOKEN=  META_APP_SECRET=   # after Meta business verification

# Launching ads from Cendoor (Meta). Needs a Meta app; see README. Until set, the ad flow runs as a dry run on a demo account.
# META_APP_ID=
# META_APP_SECRET=
# CENDOOR_TOKEN_KEY=long-random-text   # encrypts ad-account tokens at rest
# ADS_MAD_PER_USD=10                   # used to convert a MAD budget for USD ad accounts
